{
  "name": "agent-lens",
  "version": "1.0.0",
  "description": "Visual DOM feedback and issue tracker built for AI coding agents",
  "main": "dist/agent-lens.js",
  "bin": {
    "agentlens": "cli/agentlens_cli.js"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.copyFileSync('src/agent-lens.js', 'dist/agent-lens.js');\"",
