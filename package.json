  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "cursor",
    "claude-code",
    "antigravity",
    "copilot",
    "ui-feedback",
    "github-issues",
    "dom-inspector",
    "zero-ambiguity"
  ],
  "author": "Fred Hersch",
